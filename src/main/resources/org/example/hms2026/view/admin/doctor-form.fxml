<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="15.0" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.hms2026.controller_admin.DoctorFormController">
    <padding>
        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
    </padding>
    <children>
        <Label text="Doctor Information" textFill="#0f172a">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>

        <VBox spacing="10.0">
            <children>
                <Label text="ID" textFill="#64748b" />
                <TextField fx:id="txtId" promptText="Enter Doctor ID (e.g. D001)" />

                <Label text="Name" textFill="#64748b" />
                <TextField fx:id="txtName" promptText="Enter full name" />

                <Label text="Specialization" textFill="#64748b" />
                <TextField fx:id="txtSpecialization" promptText="Enter specialization (e.g. Cardiology)" />

                <Label text="Phone" textFill="#64748b" />
                <TextField fx:id="txtPhone" promptText="Enter phone number" />

                <Label text="Email" textFill="#64748b" />
                <TextField fx:id="txtEmail" promptText="Enter email address" />
            </children>
        </VBox>

        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Button onAction="#handleCancel" style="-fx-background-color: #E2E8F0; -fx-text-fill: #1E293B; -fx-cursor: hand; -fx-padding: 8px 16px; -fx-background-radius: 6px;" text="Cancel" />
                <Button onAction="#handleSave" style="-fx-background-color: #10B981; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8px 16px; -fx-background-radius: 6px;" text="Save" />
            </children>
        </HBox>
    </children>
</VBox>