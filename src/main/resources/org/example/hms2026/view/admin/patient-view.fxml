<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="16.0" style="-fx-background-color: #F8FAFC;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.hms2026.controller_admin.AdminDashboardController">
    <padding>
        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
    </padding>
    <children>
        <!-- Header Section -->
        <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: white; -fx-padding: 16px; -fx-background-radius: 12px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 8, 0, 0, 2);">
            <children>
                <VBox spacing="4.0">
                    <children>
                        <Label text="Patient Management" textFill="#0f172a">
                            <font><Font name="System Bold" size="20.0" /></font>
                        </Label>
                        <Label text="View, add, edit, and manage hospital patients database securely." textFill="#64748b">
                            <font><Font size="13.0" /></font>
                        </Label>
                    </children>
                </VBox>
                <HBox HBox.hgrow="ALWAYS" />
                <Button onAction="#handleAddPatient" style="-fx-background-color: #10B981; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-padding: 10px 18px; -fx-cursor: hand;" text="+ Add Patient" />
                <Button onAction="#handleEditPatient" style="-fx-background-color: #F59E0B; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-padding: 10px 18px; -fx-cursor: hand;" text="✏️ Edit" />
                <Button onAction="#handleDeletePatient" style="-fx-background-color: #EF4444; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-padding: 10px 18px; -fx-cursor: hand;" text="🗑️ Delete" />
                <Button onAction="#handleExportExcel" style="-fx-background-color: #059669; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-padding: 10px 18px; -fx-cursor: hand;" text="📊 Excel" />
                <Button onAction="#handleExportPDF" style="-fx-background-color: #DC2626; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-padding: 10px 18px; -fx-cursor: hand;" text="📄 PDF" />
            </children>
        </HBox>

        <!-- Table Section -->
        <TableView fx:id="tblPatients" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 12px; -fx-border-radius: 12px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 6, 0, 0, 1);">
            <columns>
                <TableColumn fx:id="colId" prefWidth="90.0" text="ID" />
                <TableColumn fx:id="colName" prefWidth="180.0" text="Full Name" />
                <TableColumn fx:id="colEmail" prefWidth="200.0" text="Email Address" />
                <TableColumn fx:id="colPhone" prefWidth="140.0" text="Phone Number" />
                <TableColumn fx:id="colDiagnosis" prefWidth="180.0" text="Diagnosis" />
            </columns>
        </TableView>
    </children>
</VBox>