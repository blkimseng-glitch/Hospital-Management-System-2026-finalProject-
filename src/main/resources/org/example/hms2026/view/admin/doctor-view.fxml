<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="16.0" style="-fx-background-color: #F8FAFC;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.hms2026.controller_admin.DoctorViewController">
    <padding>
        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
    </padding>
    <children>
        <!-- Header Section -->
        <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: white; -fx-padding: 16px; -fx-background-radius: 12px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 8, 0, 0, 2);">
            <children>
                <VBox spacing="4.0">
                    <children>
                        <Label text="Doctor Management" textFill="#0f172a">
                            <font><Font name="System Bold" size="20.0" /></font>
                        </Label>
                        <Label text="View, add, edit, and oversee hospital medical specialists." textFill="#64748b">
                            <font><Font size="13.0" /></font>
                        </Label>
                    </children>
                </VBox>
                <HBox HBox.hgrow="ALWAYS" />
                <Button onAction="#handleAddDoctor" style="-fx-background-color: #10B981; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-padding: 10px 18px; -fx-cursor: hand;" text="+ Add Doctor" />
                <Button onAction="#handleEditDoctor" style="-fx-background-color: #F59E0B; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-padding: 10px 18px; -fx-cursor: hand;" text="✏️ Edit" />
                <Button onAction="#handleDeleteDoctor" style="-fx-background-color: #EF4444; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-padding: 10px 18px; -fx-cursor: hand;" text="🗑️ Delete" />
            </children>
        </HBox>

        <!-- Table Section -->
        <TableView fx:id="tblDoctors" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 12px; -fx-border-radius: 12px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 6, 0, 0, 1);">
            <columns>
                <TableColumn fx:id="colDoctorId" prefWidth="90.0" text="ID" />
                <TableColumn fx:id="colDoctorName" prefWidth="180.0" text="Doctor Name" />
                <TableColumn fx:id="colDoctorSpecialization" prefWidth="180.0" text="Specialization" />
                <TableColumn fx:id="colDoctorPhone" prefWidth="140.0" text="Phone" />
                <TableColumn fx:id="colDoctorEmail" prefWidth="200.0" text="Email" />
            </columns>
        </TableView>
    </children>
</VBox>