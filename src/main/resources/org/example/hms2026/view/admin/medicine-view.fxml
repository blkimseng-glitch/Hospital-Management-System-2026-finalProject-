<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" style="-fx-background-color: #F8FAFC;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.hms2026.controller_admin.AdminDashboardController">
    <padding>
        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
    </padding>
    <children>
        <!-- Top Header & Action Buttons -->
        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <VBox spacing="3.0">
                <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #0F172A;" text="Medicine Stock" />
                <Label style="-fx-font-size: 13px; -fx-text-fill: #64748B;" text="Manage hospital medicine inventory, quantities, and pricing records." />
            </VBox>
            <Pane HBox.hgrow="ALWAYS" />
            <TextField promptText="Search medicine..." style="-fx-pref-width: 220px; -fx-pref-height: 35px; -fx-background-radius: 6px; -fx-border-color: #CBD5E1; -fx-border-radius: 6px;" />
            <Button onAction="#handleAddMedicine" style="-fx-background-color: #10B981; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-height: 35px; -fx-padding: 0 15px; -fx-background-radius: 6px; -fx-cursor: hand;" text="+ Add Medicine" />
            <Button onAction="#handleEditMedicine" style="-fx-background-color: #F59E0B; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-height: 35px; -fx-padding: 0 15px; -fx-background-radius: 6px; -fx-cursor: hand;" text="✎ Edit Stock" />
            <Button onAction="#handleDeleteMedicine" style="-fx-background-color: #EF4444; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-height: 35px; -fx-padding: 0 15px; -fx-background-radius: 6px; -fx-cursor: hand;" text="🗑 Delete" />
        </HBox>

        <!-- Table Container Card -->
        <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 10px; -fx-padding: 20px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 4);" VBox.vgrow="ALWAYS">
            <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="All Inventory Items" />

            <TableView fx:id="tblMedicineStock" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colMedId" prefWidth="130.0" text="Medicine ID" />
                    <TableColumn fx:id="colMedName" prefWidth="220.0" text="Medicine Name" />
                    <TableColumn fx:id="colMedCategory" prefWidth="180.0" text="Category" />
                    <TableColumn fx:id="colMedQuantity" prefWidth="150.0" text="Quantity in Stock" />
                    <TableColumn fx:id="colMedPrice" prefWidth="150.0" text="Unit Price ($)" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>
    </children>
</VBox>