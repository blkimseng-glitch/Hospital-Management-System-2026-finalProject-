<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<HBox prefHeight="650.0" prefWidth="950.0" stylesheets="@../../css/modern-theme.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.hms2026.controller_auth.LoginController">
    <children>
        <!-- Left Side: Modern Hero / Branding Area -->
        <VBox alignment="CENTER_LEFT" prefHeight="650.0" prefWidth="420.0" spacing="20.0" styleClass="hero-banner" HBox.hgrow="ALWAYS">
            <children>
                <Label text="🏥 HealthTech" textFill="#60A5FA">
                    <font>
                        <Font name="System Bold" size="28.0" />
                    </font>
                </Label>
                <Label text=" Hospital Management System " textFill="#FFFFFF" wrapText="true">
                    <font>
                        <Font name="System Bold" size="32.0" />
                    </font>
                </Label>
                <Label text="" textFill="#94A3B8" wrapText="true">
                    <font>
                        <Font size="15.0" />
                    </font>
                </Label>
            </children>
            <padding>
                <Insets bottom="50.0" left="50.0" right="50.0" top="50.0" />
            </padding>
        </VBox>

        <!-- Right Side: Login Form -->
        <VBox alignment="CENTER" prefHeight="650.0" prefWidth="530.0" style="-fx-background-color: #0F172A;" HBox.hgrow="NEVER">
            <children>
                <VBox maxHeight="480.0" maxWidth="390.0" spacing="18.0" styleClass="login-card">
                    <children>
                        <VBox spacing="4.0">
                            <children>
                                <Label text="Welcome Back!" textFill="#0F172A">
                                    <font>
                                        <Font name="System Bold" size="22.0" />
                                    </font>
                                </Label>
                                <Label text="Please select your portal role to log in." textFill="#64748B" />
                            </children>
                        </VBox>

                        <VBox spacing="6.0">
                            <children>
                                <Label text="Portal Access Role" textFill="#334155">
                                    <font>
                                        <Font name="System Bold" size="12.0" />
                                    </font>
                                </Label>
                                <ComboBox fx:id="cmbRole" prefWidth="390.0" />
                            </children>
                        </VBox>

                        <VBox spacing="6.0">
                            <children>
                                <Label text="Username or Email" textFill="#334155">
                                    <font>
                                        <Font name="System Bold" size="12.0" />
                                    </font>
                                </Label>
                                <TextField fx:id="txtUsername" promptText="Enter your credentials" />
                            </children>
                        </VBox>

                        <VBox spacing="6.0">
                            <children>
                                <Label text="Password" textFill="#334155">
                                    <font>
                                        <Font name="System Bold" size="12.0" />
                                    </font>
                                </Label>
                                <PasswordField fx:id="txtPassword" promptText="••••••••" />
                            </children>
                        </VBox>

                        <Label fx:id="lblError" textFill="#EF4444" visible="false" wrapText="true" />

                        <Button fx:id="btnLogin" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleLogin" styleClass="btn-primary-gradient" text="Sign In " />
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</HBox>