<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15.0" prefWidth="400.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.hms2026.controller_admin.MedicineFormController">
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>
    <children>
        <Label text="Add New Medicine Stock" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0F172A;"/>

        <VBox spacing="5.0">
            <Label text="Medicine ID"/>
            <TextField fx:id="txtMedicineId" promptText="e.g. M001"/>
        </VBox>

        <VBox spacing="5.0">
            <Label text="Medicine Name"/>
            <TextField fx:id="txtMedicineName" promptText="e.g. Paracetamol"/>
        </VBox>

        <VBox spacing="5.0">
            <Label text="Category"/>
            <TextField fx:id="txtCategory" promptText="e.g. Painkiller / Antibiotic"/>
        </VBox>

        <VBox spacing="5.0">
            <Label text="Quantity in Stock"/>
            <TextField fx:id="txtQuantity" promptText="e.g. 100"/>
        </VBox>

        <VBox spacing="5.0">
            <Label text="Unit Price ($)"/>
            <TextField fx:id="txtUnitPrice" promptText="e.g. 5.50"/>
        </VBox>

        <HBox spacing="10.0" alignment="CENTER_RIGHT" style="-fx-padding: 10px 0 0 0;">
            <Button text="Cancel" fx:id="btnCancel" onAction="#handleCancel" style="-fx-background-color: #CBD5E1; -fx-cursor: hand;"/>
            <Button text="Save Medicine" fx:id="btnSave" onAction="#handleSave" style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-cursor: hand;"/>
        </HBox>
    </children>
</VBox>