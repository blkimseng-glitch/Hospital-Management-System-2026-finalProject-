<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefWidth="450.0" spacing="12.0" style="-fx-background-color: #FFFFFF; -fx-padding: 24px;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.hms2026.controller_admin.PatientFormController">
    <children>
        <Label fx:id="lblFormTitle" text="Add New Patient" textFill="#0f172a">
            <font>
                <Font name="System Bold" size="20.0" />
            </font>
        </Label>

        <HBox spacing="10.0">
            <children>
                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="Patient ID" textFill="#475569" />
                        <TextField fx:id="txtId" promptText="P-001" />
                    </children>
                </VBox>
                <VBox prefWidth="120.0" spacing="4.0">
                    <children>
                        <Label text="Age" textFill="#475569" />
                        <TextField fx:id="txtAge" promptText="25" />
                    </children>
                </VBox>
            </children>
        </HBox>

        <VBox spacing="4.0">
            <children>
                <Label text="Full Name" textFill="#475569" />
                <TextField fx:id="txtName" promptText="Enter full name" />
            </children>
        </VBox>

        <HBox spacing="10.0">
            <children>
                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="Email Address" textFill="#475569" />
                        <TextField fx:id="txtEmail" promptText="patient@gmail.com" />
                    </children>
                </VBox>
                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="Phone Number" textFill="#475569" />
                        <TextField fx:id="txtPhone" promptText="012345678" />
                    </children>
                </VBox>
            </children>
        </HBox>

        <HBox spacing="10.0">
            <children>
                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="Gender" textFill="#475569" />
                        <ComboBox fx:id="cmbGender" maxWidth="1.7976931348623157E308" promptText="Select Gender" />
                    </children>
                </VBox>
                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="Blood Group" textFill="#475569" />
                        <ComboBox fx:id="cmbBloodGroup" maxWidth="1.7976931348623157E308" promptText="Select Group" />
                    </children>
                </VBox>
            </children>
        </HBox>

        <VBox spacing="4.0">
            <children>
                <Label text="Diagnosis / Symptom" textFill="#475569" />
                <TextField fx:id="txtDiagnosis" promptText="Flu, Fever, etc." />
            </children>
        </VBox>

        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Button onAction="#handleCancel" style="-fx-background-color: #E2E8F0; -fx-text-fill: #475569; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-padding: 8px 16px; -fx-cursor: hand;" text="Cancel" />
                <Button onAction="#handleSave" style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-padding: 8px 16px; -fx-cursor: hand;" text="Save Patient" />
            </children>
            <VBox.margin>
                <Insets top="10.0" />
            </VBox.margin>
        </HBox>
    </children>
</VBox>