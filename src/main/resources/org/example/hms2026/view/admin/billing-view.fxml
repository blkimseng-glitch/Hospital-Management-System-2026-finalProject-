<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" style="-fx-background-color: #F4F6F9;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.hms2026.controller_admin.AdminBillingController">
    <padding>
        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
    </padding>
    <children>
        <!-- Top Header & Action Buttons -->
        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <VBox spacing="4.0">
                    <children>
                        <Label text="Billing &amp; Invoices" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
                        <Label text="Manage hospital patient invoices, payments, and billing records." style="-fx-font-size: 13px; -fx-text-fill: #6B7280;" />
                    </children>
                </VBox>
                <HBox HBox.hgrow="ALWAYS" />
                <TextField fx:id="txtSearch" promptText="🔍 Search invoice or patient..." style="-fx-pref-width: 250px; -fx-padding: 8px 12px; -fx-background-radius: 8px; -fx-border-color: #D1D5DB; -fx-border-radius: 8px;" />
                <Button onAction="#handleCreateInvoice" style="-fx-background-color: #1A56DB; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10px 18px; -fx-background-radius: 8px; -fx-cursor: hand;" text="+ Create Invoice" />
                <Button onAction="#handleDeleteInvoice" style="-fx-background-color: #EF4444; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10px 18px; -fx-background-radius: 8px; -fx-cursor: hand;" text="🗑 Delete" />
            </children>
        </HBox>

        <!-- Main Table Container Card -->
        <VBox spacing="12.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 12px; -fx-padding: 18px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.04), 8, 0, 0, 2);" VBox.vgrow="ALWAYS">
            <children>
                <Label text="All Generated Invoices" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1F2937;" />
                <TableView fx:id="tblAdminBilling" VBox.vgrow="ALWAYS" styleClass="table-view">
                    <columns>
                        <TableColumn fx:id="colBillId" prefWidth="100.0" text="Invoice ID" />
                        <TableColumn fx:id="colPatientName" prefWidth="180.0" text="Patient Name" />
                        <TableColumn fx:id="colDoctorName" prefWidth="180.0" text="Doctor Name" />
                        <TableColumn fx:id="colDescription" prefWidth="350.0" text="Description / Diagnosis" />
                        <TableColumn fx:id="colAmount" prefWidth="140.0" text="Amount ($)" />
                        <TableColumn fx:id="colStatus" prefWidth="130.0" text="Status" />
                    </columns>
                </TableView>
            </children>
        </VBox>
    </children>
</VBox>