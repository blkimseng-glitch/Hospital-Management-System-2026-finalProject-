<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="850.0" prefWidth="1380.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.hms2026.controller_patient.PatientDashboardController">

    <!-- Left Sidebar Menu -->
    <left>
        <VBox style="-fx-background-color: #1A56DB; -fx-border-color: #E5E7EB; -fx-border-width: 0 1 0 0;" prefWidth="260.0" minWidth="260.0" maxWidth="260.0" spacing="16.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="24.0" bottom="24.0" left="16.0" right="16.0" />
            </padding>
            <children>
                <!-- Patient Profile Avatar Card -->
                <VBox alignment="CENTER" spacing="8.0" style="-fx-background-color: rgba(255, 255, 255, 0.1); -fx-background-radius: 12px; -fx-padding: 16px;">
                    <Label text="🧑‍" style="-fx-font-size: 32px;" />
                    <Label text="P.Dara Sok" style="-fx-font-weight: bold; -fx-font-size: 15px; -fx-text-fill: #FFFFFF;" />
                    <Label text="Member ID: P-1002" style="-fx-font-size: 11px; -fx-text-fill: #E0E7FF;" />
                </VBox>

                <!-- Navigation Menu -->
                <VBox spacing="8.0" VBox.vgrow="ALWAYS">
                    <children>
                        <Button fx:id="btnNavAppointments" onAction="#handleSwitchView" text="📅  My Appointments" maxWidth="Infinity" style="-fx-alignment: CENTER_LEFT; -fx-padding: 12px 14px; -fx-background-radius: 8px; -fx-font-size: 13px; -fx-background-color: transparent; -fx-text-fill: #E0E7FF; -fx-cursor: hand;" />
                        <Button fx:id="btnNavHistory" onAction="#handleSwitchView" text="📋  Medical History &amp; Rx" maxWidth="Infinity" style="-fx-alignment: CENTER_LEFT; -fx-padding: 12px 14px; -fx-background-radius: 8px; -fx-font-size: 13px; -fx-background-color: transparent; -fx-text-fill: #E0E7FF; -fx-cursor: hand;" />
                        <Button fx:id="btnNavBilling" onAction="#handleSwitchView" text="💳  Invoices &amp; Billing" maxWidth="Infinity" style="-fx-alignment: CENTER_LEFT; -fx-padding: 12px 14px; -fx-background-radius: 8px; -fx-font-size: 13px; -fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" />
                    </children>
                </VBox>

                <!-- Logout Button -->
                <Button onAction="#handleLogout" text="🚪  Logout" maxWidth="Infinity" style="-fx-background-color: rgba(255, 255, 255, 0.1); -fx-text-fill: #FFD2D2; -fx-font-weight: bold; -fx-padding: 10px; -fx-background-radius: 8px; -fx-cursor: hand; -fx-alignment: CENTER;" />
            </children>
        </VBox>
    </left>

    <!-- Main Content Area -->
    <center>
        <BorderPane style="-fx-background-color: #F4F6F9;">
            <!-- Top Header Bar -->
            <top>
                <HBox alignment="CENTER_LEFT" style="-fx-padding: 18px 28px; -fx-background-color: #FFFFFF; -fx-border-color: #E5E7EB; -fx-border-width: 0 0 1 0;" spacing="20.0">
                    <children>
                        <Label text="Patient Dashboard" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
                        <HBox HBox.hgrow="ALWAYS" />
                        <HBox alignment="CENTER" spacing="16.0">
                            <Label text="Notifications" style="-fx-text-fill: #4B5563; -fx-font-weight: bold; -fx-cursor: hand;" />
                            <Label text="Profile" style="-fx-text-fill: #4B5563; -fx-font-weight: bold; -fx-cursor: hand;" />
                        </HBox>
                    </children>
                </HBox>
            </top>

            <!-- Dynamic Views StackPane -->
            <center>
                <StackPane fx:id="contentArea" style="-fx-background-color: #F4F6F9;">
                    <padding>
                        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
                    </padding>
                    <children>

                        <!-- View 1: My Appointments -->
                        <VBox fx:id="viewAppointments" spacing="16.0" visible="false">
                            <children>
                                <VBox spacing="12.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 12px; -fx-padding: 18px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.04), 8, 0, 0, 2);" VBox.vgrow="ALWAYS">
                                    <children>
                                        <Label text="📅 My Appointment History" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
                                        <TableView fx:id="tblMyAppointments" VBox.vgrow="ALWAYS" styleClass="table-view">
                                            <columns>
                                                <TableColumn fx:id="colApptId" prefWidth="120.0" text="ID" />
                                                <TableColumn fx:id="colApptDoctor" prefWidth="300.0" text="Doctor Name" />
                                                <TableColumn fx:id="colApptDate" prefWidth="300.0" text="Date &amp; Time" />
                                                <TableColumn fx:id="colApptStatus" prefWidth="200.0" text="Status" />
                                            </columns>
                                        </TableView>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>

                        <!-- View 2: Medical History & Rx -->
                        <VBox fx:id="viewHistory" spacing="16.0" visible="false">
                            <children>
                                <VBox spacing="12.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 12px; -fx-padding: 18px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.04), 8, 0, 0, 2);" VBox.vgrow="ALWAYS">
                                    <children>
                                        <Label text="📋 My Medical Diagnosis &amp; Prescriptions" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
                                        <TableView fx:id="tblMedicalHistory" VBox.vgrow="ALWAYS" styleClass="table-view">
                                            <columns>
                                                <TableColumn fx:id="colHistBillId" prefWidth="100.0" text="Reference ID" />
                                                <TableColumn fx:id="colHistDoctor" prefWidth="160.0" text="Attending Doctor" />
                                                <TableColumn fx:id="colHistDiagnosis" prefWidth="180.0" text="Diagnosis" />
                                                <TableColumn fx:id="colHistMedicine" prefWidth="180.0" text="Medications" />
                                                <TableColumn fx:id="colHistDetails" prefWidth="250.0" text="Details &amp; Treatment Notes" />
                                                <TableColumn fx:id="colHistStatus" prefWidth="100.0" text="Status" />
                                            </columns>
                                        </TableView>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>

                        <!-- View 3: Invoices & Billing (រចនាប័ទ្មវិក្កយបត្រ Receipt ពេញលេញ) -->
                        <VBox fx:id="viewBilling" spacing="16.0" visible="true">
                            <children>
                                <VBox spacing="14.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 12px; -fx-padding: 20px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.04), 8, 0, 0, 2);" VBox.vgrow="ALWAYS">
                                    <children>
                                        <!-- Header Title & Receipt Meta Info -->
                                        <HBox alignment="CENTER_LEFT">
                                            <children>
                                                <Label text="💳 Hospital Invoice &amp; Payment Receipt" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
                                                <HBox HBox.hgrow="ALWAYS" />
                                                <VBox alignment="TOP_RIGHT" spacing="2.0">
                                                    <Label text="RECEIPT" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1E40AF;" />
                                                    <Label fx:id="lblReceiptDate" text="Date: 2026-09-24" style="-fx-font-size: 12px; -fx-text-fill: #6B7280;" />
                                                </VBox>
                                            </children>
                                        </HBox>

                                        <Separator style="-fx-padding: 4 0 4 0;" />

                                        <!-- Main Items Table -->
                                        <TableView fx:id="tblMyBilling" prefHeight="250.0" styleClass="table-view">
                                            <columns>
                                                <TableColumn fx:id="colBillId" prefWidth="100.0" text="Code" />
                                                <TableColumn fx:id="colBillDoctor" prefWidth="180.0" text="Practitioner Name" />
                                                <TableColumn fx:id="colBillDetails" prefWidth="420.0" text="Description of Service / Treatment / Medicine" />
                                                <TableColumn fx:id="colBillAmount" prefWidth="150.0" text="Rate / Charge ($)" />
                                                <TableColumn fx:id="colBillStatus" prefWidth="130.0" text="Payment Status" />
                                            </columns>
                                        </TableView>

                                        <!-- Lower Split Section: Payment Methods (Left) & Totals Calculation (Right) -->
                                        <HBox spacing="20.0" VBox.vgrow="ALWAYS" style="-fx-padding: 10 0 0 0;">
                                            <children>
                                                <!-- Left: Notes & Payment Method Options -->
                                                <VBox spacing="8.0" prefWidth="380.0" style="-fx-background-color: #F9FAFB; -fx-background-radius: 8px; -fx-padding: 12px; -fx-border-color: #E5E7EB; -fx-border-radius: 8px;">
                                                    <children>
                                                        <Label text="Notes / Payment by:" style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #374151;" />
                                                        <CheckBox text="Cash" style="-fx-font-size: 12px;" />
                                                        <CheckBox text="Cheque with number" style="-fx-font-size: 12px;" />
                                                        <CheckBox text="Credit card" style="-fx-font-size: 12px;" />
                                                        <CheckBox text="Insurance" style="-fx-font-size: 12px;" />
                                                        <CheckBox text="Others (KHQR / Bank Transfer)" selected="true" style="-fx-font-size: 12px;" />
                                                    </children>
                                                </VBox>

                                                <HBox HBox.hgrow="ALWAYS" />

                                                <!-- Right: Calculations & Balance Due Box -->
                                                <VBox spacing="10.0" prefWidth="380.0">
                                                    <children>
                                                        <GridPane hgap="10.0" vgap="6.0">
                                                            <columnConstraints>
                                                                <ColumnConstraints percentWidth="60.0" halignment="RIGHT" />
                                                                <ColumnConstraints percentWidth="40.0" halignment="RIGHT" />
                                                            </columnConstraints>
                                                            <rowConstraints>
                                                                <RowConstraints />
                                                                <RowConstraints />
                                                                <RowConstraints />
                                                                <RowConstraints />
                                                            </rowConstraints>
                                                            <children>
                                                                <Label text="SUBTOTAL:" style="-fx-font-weight: bold; -fx-text-fill: #4B5563; -fx-font-size: 12px;" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                                                <Label fx:id="lblSubtotal" text="22$" style="-fx-font-weight: bold; -fx-text-fill: #111827; -fx-font-size: 12px;" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                                                <Label text="DISCOUNT:" style="-fx-font-weight: bold; -fx-text-fill: #4B5563; -fx-font-size: 12px;" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                                                <Label text="0.0$" style="-fx-font-weight: bold; -fx-text-fill: #111827; -fx-font-size: 12px;" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                                                <Label text="TAX RATE:" style="-fx-font-weight: bold; -fx-text-fill: #4B5563; -fx-font-size: 12px;" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                                                <Label text="0.0%" style="-fx-font-weight: bold; -fx-text-fill: #111827; -fx-font-size: 12px;" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                                                                <Label text="TOTAL TAX:" style="-fx-font-weight: bold; -fx-text-fill: #4B5563; -fx-font-size: 12px;" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                                                                <Label text="0.00$" style="-fx-font-weight: bold; -fx-text-fill: #111827; -fx-font-size: 12px;" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                                                            </children>
                                                        </GridPane>

                                                        <Separator />

                                                        <!-- Balance Due Highlight Box -->
                                                        <HBox alignment="CENTER_LEFT" style="-fx-background-color: #D1D5DB; -fx-background-radius: 6px; -fx-padding: 10px 14px;">
                                                            <children>
                                                                <Label text="Balance Due" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1F2937;" />
                                                                <HBox HBox.hgrow="ALWAYS" />
                                                                <Label fx:id="lblBalanceDue" text="2.20$" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
                                                            </children>
                                                        </HBox>
                                                    </children>
                                                </VBox>
                                            </children>
                                        </HBox>

                                        <!-- Pay Action Button -->
                                        <HBox alignment="CENTER_RIGHT" style="-fx-padding: 6px 0 0 0;">
                                            <Button onAction="#handlePayBill" style="-fx-background-color: #10B981; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12px 26px; -fx-background-radius: 8px; -fx-cursor: hand; -fx-font-size: 14px;" text="🚀 Pay Selected Invoice (KHQR)" />
                                        </HBox>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>

                    </children>
                </StackPane>
            </center>
        </BorderPane>
    </center>
</BorderPane>