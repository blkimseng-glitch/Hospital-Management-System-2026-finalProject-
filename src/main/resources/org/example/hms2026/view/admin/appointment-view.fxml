<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="16.0" style="-fx-background-color: #F8FAFC;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.hms2026.controller_admin.AppointmentViewController">
    <padding>
        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
    </padding>
    <children>
        <!-- Header Section -->
        <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: white; -fx-padding: 16px; -fx-background-radius: 12px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 8, 0, 0, 2);">
            <children>
                <VBox spacing="4.0">
                    <children>
                        <Label text="Appointment Management" textFill="#0f172a">
                            <font><Font name="System Bold" size="20.0" /></font>
                        </Label>
                        <Label text="View and manage hospital patient appointments schedule." textFill="#64748b">
                            <font><Font size="13.0" /></font>
                        </Label>
                    </children>
                </VBox>
                <HBox HBox.hgrow="ALWAYS" />
                <Button onAction="#handleAddAppointment" style="-fx-background-color: #10B981; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-padding: 10px 18px; -fx-cursor: hand;" text="+ Add Appointment" />
                <Button onAction="#handleEditAppointment" style="-fx-background-color: #F59E0B; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-padding: 10px 18px; -fx-cursor: hand;" text="✏️ Edit" />
                <Button onAction="#handleDeleteAppointment" style="-fx-background-color: #EF4444; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-padding: 10px 18px; -fx-cursor: hand;" text="🗑️ Delete" />
            </children>
        </HBox>

        <!-- Table Section -->
        <TableView fx:id="tblAppointments" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 12px; -fx-border-radius: 12px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 6, 0, 0, 1);">
            <columns>
                <TableColumn fx:id="colAppointmentId" prefWidth="90.0" text="ID" />
                <TableColumn fx:id="colPatientName" prefWidth="180.0" text="Patient Name" />
                <TableColumn fx:id="colDoctorName" prefWidth="180.0" text="Doctor Name" />
                <TableColumn fx:id="colAppointmentDate" prefWidth="180.0" text="Date &amp; Time" />
                <TableColumn fx:id="colStatus" prefWidth="120.0" text="Status" />
            </columns>
        </TableView>
    </children>
</VBox>